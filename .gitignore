__pycache__/
*.pyc
.ipynb_checkpoints/

# Variáveis de ambiente e credenciais
.env
.env.*
*.pem
*.key
credentials*.json
secrets*.json

# Configurações pessoais de ferramentas e do editor
.claude/
.vscode/

# Arquivos do sistema operacional
Thumbs.db
desktop.ini

# Arquivos auxiliares e temporários dos dados (não publicar)
dados/temporarios/
